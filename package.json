{
  "name": "metamodelica-language-server",
  "displayName": "MetaModelica Language Server",
  "description": "[Experimental] MetaModelica language server",
  "version": "0.3.0",
  "author": "Andreas Heuermann",
  "license": "See License.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenModelica/metamodelica-language-server"
  },
  "publisher": "OpenModelica",
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "modelica",
    "metamodelica",
    "language",
    "language-server"
  ],
  "homepage": "https://github.com/OpenModelica/metamodelica-language-server",
  "icon": "images/Modelica_Language_margin.jpg",
  "bugs": "https://github.com/OpenModelica/metamodelica-language-server/issues",
  "engines": {
    "vscode": "^1.120.0",
    "node": ">=22"
  },
  "activationEvents": [
    "onLanguage:metamodelica",
    "onDebugResolve:metamodelica-dbg",
    "onCommand:metamodelica.debug.prettyPrintVariable"
  ],
  "main": "./out/client",
  "contributes": {
    "languages": [
      {
        "id": "metamodelica",
        "aliases": [
          "MetaModelica",
          "metamodelica"
        ],
        "extensions": [
          ".mo"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "metamodelica"
      }
    ],
    "commands": [
      {
        "command": "metamodelica.debug.prettyPrintVariable",
        "title": "Pretty Print MetaModelica Value",
        "category": "MetaModelica"
      }
    ],
    "menus": {
      "debug/variables/context": [
        {
          "command": "metamodelica.debug.prettyPrintVariable",
          "when": "debugType == 'metamodelica-dbg'",
          "group": "navigation@50"
        }
      ],
      "commandPalette": [
        {
          "command": "metamodelica.debug.prettyPrintVariable",
          "when": "false"
        }
      ]
    },
    "debuggers": [
      {
        "type": "metamodelica-dbg",
        "languages": [
          "metamodelica"
        ],
        "label": "MetaModelica Debug",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "gdb"
            ],
            "properties": {
              "gdb": {
                "type": "string",
                "description": "Absolute path to GDB executable.",
                "default": "gdb"
              },
              "program": {
                "type": "string",
                "description": "Absolute path to OpenModelica Compiler executable omc.",
                "default": "${workspaceFolder}/build_cmake/install_cmake/bin/omc"
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments to omc. e.g., MOS file",
                "default": [
                  "script.mos"
                ]
              },
              "cwd": {
                "type": "string",
                "description": "Absolute path to working directory.",
                "default": "${workspaceFolder}"
              },
              "logLevel": {
                "type": "string",
                "description": "Logging level for the debugger",
                "default": "warning",
                "enum": [
                  "debug",
                  "log",
                  "info",
                  "warning",
                  "error"
                ]
              },
              "showRuntimeLocals": {
                "type": "boolean",
                "description": "Show generated C temporaries and runtime locals in addition to MetaModelica locals.",
                "default": false
              },
              "printElements": {
                "type": "number",
                "description": "GDB print elements limit for explicit string output. Use 0 for unlimited.",
                "default": 10000
              },
              "setupCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Additional raw GDB/MI setup commands sent after the default setup.",
                "default": []
              },
              "autoPrettyPrint": {
                "type": "boolean",
                "description": "Try conventional MetaModelica pretty-printers eagerly in the Variables value column. This can be slow for backend values; prefer the lazy [pretty] child.",
                "default": false
              },
              "autoPrettyMaxLength": {
                "type": "number",
                "description": "Maximum Variables-view pretty preview length. Longer output is truncated in the value column.",
                "default": 240
              },
              "autoPrettyMaxCollectionLength": {
                "type": "number",
                "description": "Maximum direct list/array/tuple length for automatic Variables-view pretty previews. Larger collections stay structural and expandable.",
                "default": 25
              },
              "autoPrettyMaxPerRequest": {
                "type": "number",
                "description": "Maximum automatic pretty preview attempts per Variables request.",
                "default": 40
              },
              "lazyPrettyMaxLength": {
                "type": "number",
                "description": "Maximum output length for the lazy [pretty] child in the Variables view.",
                "default": 12000
              },
              "maxIndexedChildren": {
                "type": "number",
                "description": "Maximum indexed list/array/tuple children shown when expanding one MetaModelica value. Larger values show a truncation row and can still be traversed structurally.",
                "default": 100
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "MetaModelica Debug Launch Configuration",
            "type": "metamodelica-dbg",
            "request": "launch",
            "gdb": "gdb",
            "program": "omc",
            "arguments": [
              "script.mos"
            ],
            "cwd": "${workspaceFolder}",
            "logLevel": "info",
            "showRuntimeLocals": false,
            "printElements": 10000,
            "autoPrettyPrint": false,
            "autoPrettyMaxLength": 240,
            "autoPrettyMaxCollectionLength": 25,
            "autoPrettyMaxPerRequest": 40,
            "lazyPrettyMaxLength": 12000,
            "maxIndexedChildren": 100
          }
        ],
        "configurationSnippets": [
          {
            "label": "MetMetaModelica Debug Launch Configuration",
            "description": "A new configuration for 'debugging' the OpenModelica compiler.",
            "body": {
              "name": "MetaModelica Debug Launch Configuration",
              "type": "metamodelica-dbg",
              "request": "launch",
              "gdb": "gdb",
              "program": "omc",
              "arguments": [
                "script.mos"
              ],
              "cwd": "${workspaceFolder}",
              "logLevel": "info",
              "showRuntimeLocals": false,
              "printElements": 10000,
              "autoPrettyPrint": false,
              "autoPrettyMaxLength": 240,
              "autoPrettyMaxCollectionLength": 25,
              "autoPrettyMaxPerRequest": 40,
              "lazyPrettyMaxLength": 12000,
              "maxIndexedChildren": 100
            }
          }
        ]
      }
    ]
  },
  "bin": {
    "mmlsc": "./out/cli.js"
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.config.js --minify",
    "esbuild": "node esbuild.config.js",
    "esbuild-watch": "node esbuild.config.js --watch",
    "test-compile": "tsc -b ./",
    "lint": "eslint ./src/** ./test/** --ext .ts,.tsx",
    "tree-sitter-metamodelica": "cd src/server && node tree.sitter.metamodelica.download.js",
    "tree-sitter-gdbmi": "tree-sitter build --wasm --output src/debugger/parser/tree-sitter-gdbmi.wasm node_modules/tree-sitter-gdbmi",
    "postinstall": "npm run tree-sitter-metamodelica && npm run tree-sitter-gdbmi",
    "test": "npm run test-compile && node ./dist/test/runTest",
    "all": "npm run postinstall && npm run esbuild && npm run lint && npm run test && npm run vscode:prepublish"
  },
  "dependencies": {
    "tree-sitter-cli": "^0.26.9",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "web-tree-sitter": "^0.26.9"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.0",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/test-electron": "^2.5.2",
    "axios": "^1.16.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "mocha": "^11.3.0",
    "tree-sitter-gdbmi": "github:novafacing/tree-sitter-gdbmi",
    "ts-node": "^10.9.2"
  }
}
